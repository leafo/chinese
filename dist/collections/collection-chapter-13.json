  "sentences": [
    {
      "traditional": "這家餐廳的紅燒魚做得很好，非常好吃。",
      "simplified": "这家餐厅的红烧鱼做得很好，非常好吃。",
      "pinyin": "Zhè jiā cāntīng de hóngshāoyú zuò de hěn hǎo, fēicháng hǎochī.",
      "english": "This restaurant's braised fish is made very well; it is extremely delicious.",
      "notes": "",
      "words_used": [
        "红烧鱼",
        "非常"
      ]
    },
    {
      "traditional": "我最喜歡吃魚，什麼魚都愛吃。",
      "simplified": "我最喜欢吃鱼，什么鱼都爱吃。",
      "pinyin": "Wǒ zuì xǐhuān chī yú, shénme yú dōu ài chī.",
      "english": "I like eating fish the most; I love to eat all kinds of fish.",
      "notes": "",
      "words_used": [
        "鱼",
        "什么……都……",
        "爱"
      ]
    },
    {
      "traditional": "妳想吃豆腐還是青菜？",
      "simplified": "你想吃豆腐还是青菜？",
      "pinyin": "Nǐ xiǎng chī dòufǔ háishì qīngcài?",
      "english": "Would you like to eat tofu or green vegetables?",
      "notes": "",
      "words_used": [
        "豆腐",
        "还是",
        "青菜"
      ]
    },
    {
      "traditional": "我們點一個炸豆腐、一盤炒青菜，三碗白飯。",
      "simplified": "我们点一个炸豆腐、一盘炒青菜，三碗白饭。",
      "pinyin": "Wǒmen diǎn yí ge zhádòufǔ, yì pán chǎoqīngcài, sān wǎn báifàn.",
      "english": "Let's order one fried tofu, a plate of stir-fried green vegetables, and three bowls of steamed rice.",
      "notes": "",
      "words_used": [
        "点",
        "炸豆腐",
        "盘",
        "炒青菜",
        "碗",
        "白饭"
      ]
    },
    {
      "traditional": "酸辣湯又酸又辣，真好喝！",
      "simplified": "酸辣汤又酸又辣，真好喝！",
      "pinyin": "Suānlàtāng yòu suān yòu là, zhēn hǎohē!",
      "english": "Hot and sour soup is both sour and spicy; it's really tasty!",
      "notes": "",
      "words_used": [
        "酸辣汤",
        "酸",
        "辣",
        "好喝"
      ]
    },
    {
      "traditional": "我也想喝湯，還要一瓶啤酒。",
      "simplified": "我也想喝汤，还要一瓶啤酒。",
      "pinyin": "Wǒ yě xiǎng hē tāng, hái yào yì píng píjiǔ.",
      "english": "I also want to have soup, and I'd like a bottle of beer too.",
      "notes": "",
      "words_used": [
        "汤",
        "瓶",
        "啤酒"
      ]
    },
    {
