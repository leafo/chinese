  "sentences": [
    {
      "traditional": "Gloria覺得學中文很有意思，但是寫字很難。",
      "simplified": "Gloria觉得学中文很有意思，但是写字很难。",
      "pinyin": "Gloria juéde xué Zhōngwén hěn yǒuyìsi, dànshì xiě zì hěn nán.",
      "english": "Gloria feels that learning Chinese is very interesting, but writing characters is very difficult.",
      "notes": "",
      "words_used": [
        "觉得",
        "学",
        "中文",
        "难"
      ]
    },
    {
      "traditional": "李老師寫字寫得很快，我覺得自己寫得很慢。",
      "simplified": "李老师写字写得很快，我觉得自己写得很慢。",
      "pinyin": "Lǐ lǎoshī xiě zì xiě de hěn kuài, wǒ juéde zìjǐ xiě de hěn màn.",
      "english": "Teacher Li writes characters very fast, while I feel that I write very slowly.",
      "notes": "",
      "words_used": [
        "写字",
        "得",
        "快",
        "自己"
      ]
    },
    {
      "traditional": "你平常喜歡跟誰一起聊天練習說話？",
      "simplified": "你平常喜欢跟谁一起聊天练习说话？",
      "pinyin": "Nǐ píngcháng xǐhuan gēn shéi yìqǐ liáo tiān liànxí shuō huà?",
      "english": "Who do you usually like to chat and practice speaking with?",
      "notes": "",
      "words_used": [
        "聊天",
        "练习",
        "说话"
      ]
    },
    {
      "traditional": "這家咖啡館的咖啡很貴，但是味道很不錯。",
      "simplified": "这家咖啡馆的咖啡很贵，但是味道很不错。",
      "pinyin": "Zhè jiā kāfēiguǎn de kāfēi hěn guì, dànshì wèidao hěn búcuò.",
      "english": "The coffee in this cafe is quite expensive, but the taste is pretty good.",
      "notes": "",
      "words_used": [
        "咖啡",
        "贵",
        "不错"
      ]
    },
    {
      "traditional": "他差不多會寫一百個字，學得很不錯。",
      "simplified": "他差不多会写一百个字，学得很不错。",
      "pinyin": "Tā chàbùduō huì xiě yì bǎi ge zì, xué de hěn búcuò.",
      "english": "He can write approximately one hundred characters; he is learning quite well.",
      "notes": "",
      "words_used": [
        "差不多",
        "会",
        "字",
        "不错"
      ]
    },
    {
      "traditional": "今天工作很忙，我們去喝杯紅茶吧。",
      "simplified": "今天工作很忙，我们去喝杯红茶吧。",
      "pinyin": "Jīntiān gōngzuò hěn máng, wǒmen qù hē bēi hóngchá ba.",
      "english": "We've been very busy at work today; let's go drink a cup of black tea!",
      "notes": "",
      "words_used": [
        "喝",
        "杯",
        "吧"
      ]
    },
    {
      "traditional": "我媽媽做飯做得很快，大家都很喜歡。",
      "simplified": "我妈妈做饭做得很快，大家都很喜欢。",
      "pinyin": "Wǒ māma zuò fàn zuò de hěn kuài, dàjiā dōu hěn xǐhuan.",
      "english": "My mother cooks very quickly, and everyone likes her food.",
      "notes": "",
      "words_used": [
        "做饭",
        "得",
        "快"
      ]
    },
    {
      "traditional": "你知道那個學校有多少個學中文的學生嗎？",
      "simplified": "你知道那个学校有多少个学中文的学生吗？",
      "pinyin": "Nǐ zhīdào nà ge xuéxiào yǒu duōshǎo ge xué Zhōngwén de xuésheng ma?",
      "english": "Do you know how many students are learning Chinese at that school?",
      "notes": "",
      "words_used": [
        "多少",
        "学",
        "中文"
      ]
    },
    {
      "traditional": "走了這麼長時間的路，我們去長椅上休息一下吧。",
      "simplified": "走了这么长时间的路，我们去长椅上休息一下吧。",
      "pinyin": "Zǒu le zhème cháng shíjiān de lù, wǒmen qù chángyǐ shang xiūxí yíxià ba.",
      "english": "Having walked for such a long time, let's take a break on the bench.",
      "notes": "",
      "words_used": [
        "休息",
        "一下",
        "吧"
      ]
    },
    {
      "traditional": "我覺得學習做飯有一點難，不過很有趣。",
      "simplified": "我觉得学习做饭有一点难，不过很有趣。",
      "pinyin": "Wǒ juéde xuéxí zuò fàn yǒu yìdiǎn nán, búguò hěn yǒuqù.",
      "english": "I feel that learning to cook is a little hard, but it's very interesting.",
      "notes": "",
      "words_used": [
        "觉得",
        "做饭",
        "有一点",
        "难"
      ]
    },
    {
      "traditional": "明文經常跟朋友聊天，藉此練習他的中文。",
      "simplified": "明文经常跟朋友聊天，借此练习他的中文。",
      "pinyin": "Míngwén jīngcháng gēn péngyou liáo tiān, jiè cǐ liànxí tā de Zhōngwén.",
      "english": "Mingwen often chats with friends, thereby practicing his Chinese.",
      "notes": "",
      "words_used": [
        "聊天",
        "练习",
        "中文"
      ]
    },
    {
      "traditional": "買這台電腦太貴了，你覺得怎麼樣？",
      "simplified": "买这台电脑太贵了，你觉得怎么样？",
      "pinyin": "Mǎi zhè tái diànnǎo tài guì le, nǐ juéde zěnmeyàng?",
      "english": "Buying this computer is too expensive, what do you think?",
      "notes": "",
      "words_used": [
        "贵",
        "觉得"
      ]
    },
    {
      "traditional": "他每天自己練習說話，所以表達得越來越清楚。",
      "simplified": "他每天自己练习说话，所以表达得越来越清楚。",
      "pinyin": "Tā měitiān zìjǐ liànxí shuō huà, suǒyǐ biǎodá de yuèláiyuè qīngchu.",
      "english": "He practices speaking on his own every day, so he expresses himself more and more clearly.",
      "notes": "",
      "words_used": [
        "自己",
        "练习",
        "说话",
        "得"
      ]
    },
    {
      "traditional": "你會寫多少個漢字？差不多有一百個吧。",
      "simplified": "你会写多少个汉字？差不多有一百个吧。",
      "pinyin": "Nǐ huì xiě duōshǎo ge hànzì? Chàbùduō yǒu yì bǎi ge ba.",
      "english": "How many Chinese characters can you write? Probably around a hundred.",
      "notes": "",
      "words_used": [
        "会",
        "多少",
        "差不多",
        "字"
      ]
    },
    {
      "traditional": "下課以後，我們去喝杯咖啡聊天吧。",
      "simplified": "下课以后，我们去喝杯咖啡聊天吧。",
      "pinyin": "Xiàkè yǐhòu, wǒmen qù hē bēi kāfēi liáo tiān ba.",
      "english": "After class, let's go have a cup of coffee and chat.",
      "notes": "",
