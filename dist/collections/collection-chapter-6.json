  "sentences": [
    {
      "traditional": "我週末喜歡打網球。",
      "simplified": "我周末喜欢打网球。",
      "pinyin": "Wǒ zhōumò xǐhuān dǎ wǎngqiú.",
      "english": "On weekends I like to play tennis.",
