        "网球"
      ]
    },
    {
      "traditional": "你平常喜歡做什麼運動？",
      "simplified": "你平常喜欢做什么运动？",
      "pinyin": "Nǐ píngcháng xǐhuān zuò shénme yùndòng?",
      "english": "What sport do you usually like to do?",
      "notes": "",
      "words_used": [
        "做",
        "运动"
      ]
    },
    {
      "traditional": "她晚上常常在家看電視。",
      "simplified": "她晚上常常在家看电视。",
      "pinyin": "Tā wǎnshàng chángcháng zài jiā kàn diànshì.",
      "english": "She often watches television at home at night.",
      "notes": "",
      "words_used": [
        "晚上",
        "常常",
        "家",
        "看",
        "电视"
      ]
    },
    {
      "traditional": "誰喜歡唱歌和跳舞？",
      "simplified": "谁喜欢唱歌和跳舞？",
      "pinyin": "Shéi xǐhuān chàng gē hé tiào wǔ?",
      "english": "Who likes to sing and dance?",
      "notes": "",
      "words_used": [
        "唱歌",
        "和",
        "跳舞"
      ]
    },
    {
      "traditional": "我哥哥喜歡踢足球，你呢？",
      "simplified": "我哥哥喜欢踢足球，你呢？",
      "pinyin": "Wǒ gēge xǐhuān tī zúqiú, nǐ ne?",
      "english": "My older brother likes to play soccer; how about you?",
      "notes": "",
      "words_used": [
        "踢足球"
      ]
    },
    {
      "traditional": "那是我爸爸的電視。",
      "simplified": "那是我爸爸的电视。",
      "pinyin": "Nà shì wǒ bàba de diànshì.",
      "english": "That is my father's TV.",
      "notes": "",
      "words_used": [
        "电视"
      ]
    },
    {
      "traditional": "他們上午想去公園跑步。",
      "simplified": "他们上午想去公园跑步。",
      "pinyin": "Tāmen shàngwǔ xiǎng qù gōngyuán pǎobù.",
      "english": "They want to go jogging in the park in the morning.",
      "notes": "",
      "words_used": [
        "上午",
        "跑步"
      ]
    },
    {
      "traditional": "劉小姐喜歡聽音樂，可是她哥哥喜歡看電影。",
      "simplified": "刘小姐喜欢听音乐，可是她哥哥喜欢看电影。",
      "pinyin": "Liú xiǎojiě xǐhuān tīng yīnyuè, kěshì tā gēge xǐhuān kàn diànyǐng.",
      "english": "Ms. Liu likes to listen to music, but her older brother likes to watch movies.",
      "notes": "",
      "words_used": [
