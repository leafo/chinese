  "sentences": [
    {
      "traditional": "今天天氣很好，在這裡跑步真舒服。",
      "simplified": "今天天气很好，在这里跑步真舒服。",
      "pinyin": "Jīntiān tiānqì hěn hǎo, zài zhèlǐ pǎobù zhēn shūfu.",
      "english": "The weather is very good today; running here is really comfortable.",
      "notes": "",
      "words_used": [
        "天气",
        "这里",
        "真",
        "舒服"
      ]
    },
    {
      "traditional": "這裡的夏天比台灣的夏天舒服多了。",
      "simplified": "这里的夏天比台湾的夏天舒服多了。",
      "pinyin": "Zhèlǐ de xiàtiān bǐ Táiwān de xiàtiān shūfu duō le.",
      "english": "Summer here is much more comfortable than summer in Taiwan.",
      "notes": "",
      "words_used": [
        "这里",
        "夏天",
        "比",
        "舒服"
      ]
    },
    {
      "traditional": "台灣的春天和秋天很舒服，不冷也不熱。",
      "simplified": "台湾的春天和秋天很舒服，不冷也不热。",
      "pinyin": "Táiwān de chūntiān hé qiūtiān hěn shūfu, bù lěng yě bù rè.",
      "english": "Spring and autumn in Taiwan are very comfortable, neither cold nor hot.",
      "notes": "",
      "words_used": [
        "春天",
        "秋天",
        "舒服",
        "冷",
        "热"
      ]
    },
    {
      "traditional": "這裡的冬天不太冷，可是夏天太熱了。",
      "simplified": "这里的冬天不太冷，可是夏天太热了。",
      "pinyin": "Zhèlǐ de dōngtiān bú tài lěng, kěshì xiàtiān tài rè le.",
      "english": "Winter here is not too cold, but summer is too hot.",
      "notes": "",
      "words_used": [
        "这里",
        "冬天",
        "太",
        "冷",
        "夏天",
        "太……了",
        "热"
      ]
    },
    {
      "traditional": "下雨的時候，我們都不能出來跑步。",
      "simplified": "下雨的时候，我们都不能出来跑步。",
      "pinyin": "Xià yǔ de shíhòu, wǒmen dōu bù néng chūlái pǎobù.",
      "english": "When it rains, none of us can come out to run.",
      "notes": "",
      "words_used": [
        "下雨",
        "……的时候",
        "能",
        "出来"
      ]
    },
    {
      "traditional": "天氣預報說，明天可能會下雨。",
      "simplified": "天气预报说，明天可能会下雨。",
      "pinyin": "Tiānqì yùbào shuō, míngtiān kěnéng huì xià yǔ.",
      "english": "The weather forecast says it probably will rain tomorrow.",
      "notes": "",
      "words_used": [
        "天气预报",
        "可能",
        "会",
        "下雨"
      ]
    },
    {
      "traditional": "我希望明天是晴天，大家能一起出來玩。",
      "simplified": "我希望明天是晴天，大家能一起出来玩。",
      "pinyin": "Wǒ xīwàng míngtiān shì qíngtiān, dàjiā néng yìqǐ chūlái wán.",
      "english": "I hope tomorrow is sunny so that everyone can come out and hang out.",
      "notes": "",
      "words_used": [
        "希望",
        "晴天",
        "能",
        "出来"
      ]
    },
    {
      "traditional": "昨天雨下得很大，今天天氣一定很舒服。",
      "simplified": "昨天雨下得很大，今天天气一定很舒服。",
      "pinyin": "Zuótiān yǔ xià de hěn dà, jīntiān tiānqì yídìng hěn shūfu.",
      "english": "It rained heavily yesterday, so the weather today will definitely be comfortable.",
      "notes": "",
      "words_used": [
        "昨天",
        "大",
        "天气",
        "一定",
        "舒服"
      ]
    },
    {
      "traditional": "對，冬天的時候這裡比北方舒服。",
      "simplified": "对，冬天的时候这里比北方舒服。",
      "pinyin": "Duì, dōngtiān de shíhòu zhèlǐ bǐ běifāng shūfu.",
      "english": "Right, in the winter it is more comfortable here than in the north.",
      "notes": "",
      "words_used": [
        "对",
        "冬天",
        "……的时候",
        "这里",
        "比",
        "舒服"
      ]
    },
    {
      "traditional": "他給朋友打電話，問今天會不會下雪。",
      "simplified": "他给朋友打电话，问今天会不会下雪。",
      "pinyin": "Tā gěi péngyǒu dǎ diànhuà, wèn jīntiān huì bu huì xià xuě.",
      "english": "He called his friend to ask whether it would snow today.",
      "notes": "",
      "words_used": [
        "给",
        "会",
        "下雪"
      ]
    }
  ],
