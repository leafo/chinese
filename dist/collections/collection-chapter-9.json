  "sentences": [
    {
      "traditional": "王先生星期五有時間。",
      "simplified": "王先生星期五有时间。",
      "pinyin": "Wáng xiānsheng xīngqīwǔ yǒu shíjiān.",
      "english": "Mr. Wang has time on Friday.",
      "notes": "",
      "words_used": [
        "星期五",
        "时间"
      ]
    },
    {
      "traditional": "你想跟我一起吃飯，好不好？",
      "simplified": "你想跟我一起吃饭，好不好？",
      "pinyin": "Nǐ xiǎng gēn wǒ yìqǐ chī fàn, hǎo bù hǎo?",
      "english": "Do you want to eat together with me, okay?",
      "notes": "",
      "words_used": [
        "跟",
        "一起",
        "吃饭"
      ]
    },
    {
      "traditional": "他的同事在那個餐廳工作。",
      "simplified": "他的同事在那个餐厅工作。",
      "pinyin": "Tā de tóngshì zài nà ge cāntīng gōngzuò.",
      "english": "His coworker works at that restaurant.",
      "notes": "",
      "words_used": [
        "同事",
        "那",
        "餐厅"
      ]
    },
    {
      "traditional": "這家餐廳的牛肉麵最好吃。",
      "simplified": "这家餐厅的牛肉面最好吃。",
      "pinyin": "Zhè jiā cāntīng de niúròumiàn zuì hǎochī.",
      "english": "This restaurant's beef noodle soup is the most delicious.",
      "notes": "",
      "words_used": [
        "家",
        "餐厅",
        "牛肉面",
        "最",
        "好吃"
      ]
    },
    {
      "traditional": "誰要跟我們一起去吃晚飯？",
      "simplified": "谁要跟我们一起去吃晚饭？",
      "pinyin": "Shéi yào gēn wǒmen yìqǐ qù chī wǎn fàn?",
      "english": "Who wants to go eat dinner together with us?",
      "notes": "",
      "words_used": [
        "要",
        "跟",
        "一起",
        "晚饭"
      ]
    },
    {
      "traditional": "我下課以後五點半回來。",
      "simplified": "我下课以后五点半回来。",
      "pinyin": "Wǒ xiàkè yǐhòu wǔ diǎn bàn huílái.",
      "english": "I'll come back at five thirty after class.",
      "notes": "",
      "words_used": [
        "下课",
        "点",
        "半"
      ]
    },
    {
      "traditional": "我們星期六見，你的哥哥呢？",
      "simplified": "我们星期六见，你的哥哥呢？",
      "pinyin": "Wǒmen xīngqīliù jiàn, nǐ de gēge ne?",
      "english": "We'll meet on Saturday; and your older brother?",
      "notes": "",
      "words_used": [
        "星期六",
        "见"
      ]
    },
    {
      "traditional": "那個餐廳怎麼樣？行不行？",
      "simplified": "那个餐厅怎么样？行不行？",
      "pinyin": "Nà ge cāntīng zěnmeyàng? Xíng bù xíng?",
      "english": "How about that restaurant? Is it okay or not?",
      "notes": "",
      "words_used": [
        "那",
        "餐厅",
        "怎么样",
        "行",
        "不行"
      ]
    },
    {
      "traditional": "今天星期幾？今天星期三。",
      "simplified": "今天星期几？今天星期三。",
      "pinyin": "Jīntiān xīngqījǐ? Jīntiān xīngqīsān.",
      "english": "What day of the week is today? Today is Wednesday.",
      "notes": "",
      "words_used": [
        "星期几",
        "星期三"
      ]
    },
    {
      "traditional": "今天是二〇二一年九月十八號星期六。",
      "simplified": "今天是二〇二一年九月十八号星期六。",
      "pinyin": "Jīntiān shì èr líng èr yī nián jiǔyuè shíbā hào xīngqīliù.",
      "english": "Today is Saturday, September 18th, 2021.",
      "notes": "",
      "words_used": [
        "年",
        "星期六"
      ]
    },
    {
      "traditional": "現在幾點？現在十點二十分。",
